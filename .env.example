# Mandatory info for starting the app

REACT_APP_MORALIS_APPLICATION_ID=your_moralis_app_id
REACT_APP_MORALIS_SERVER_URL=https://your-moralis-server.usemoralis.com:2053/server

# Optional: Moralis master key (server-side / Cloud Functions only — never expose in frontend)
# MORALILS_MASTERKEY=your_moralis_master_key

REACT_APP_OPENSEA_X_API_KEY=your_opensea_api_key
REACT_APP_OPENSEA_URL=https://opensea.io
REACT_APP_OPENSEA_API_URL=https://api.opensea.io/api

REACT_APP_CONTRACT_ADDRESS=0xYourSpaceNFTContractAddress
REACT_APP_PHANTON_ADDRESS=0xYourPhantonTokenContractAddress

REACT_APP_MORALIS_X_API_KEY=your_moralis_web3_api_key
REACT_APP_BING_API_KEY=your_bing_maps_api_key

CHAIN_ID="0x1"

CESIUM_BASE_URL=https://cdnjs.cloudflare.com/ajax/libs/cesium/1.90.0/

REACT_APP_MAILCHIMP_URL=https://your-mailchimp-subscribe-url
