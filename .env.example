# Supabase (Project Settings -> API). Only the anon key belongs in the frontend.
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key

# PhantaSpace API server on Render (thumbnails, NFT metadata)
REACT_APP_API_URL=https://phantaspace.com

REACT_APP_CONTRACT_ADDRESS=0xYourSpaceNFTContractAddress
REACT_APP_PHANTON_ADDRESS=0xYourPhantonTokenContractAddress

REACT_APP_OPENSEA_X_API_KEY=your_opensea_api_key
REACT_APP_OPENSEA_URL=https://opensea.io
REACT_APP_OPENSEA_API_URL=https://api.opensea.io/api

REACT_APP_BING_API_KEY=your_bing_maps_api_key
REACT_APP_MAILCHIMP_URL=https://your-mailchimp-subscribe-url
